---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; schema?: Record<string, unknown>; canonical?: string; }
const SITE = 'https://banamailing.com';
const {
  title = 'Correos Masivos Perú y Mailing 🚀 | Email Marketing Profesional | BanaMailing®',
  description = 'Servicio líder de correos masivos Perú y campañas de mailing profesional 🚀. Envía tus correos segmentados con alta entregabilidad y mide resultados reales con BanaMailing®.',
  image = '/images/equipo-colaborativo-mision-email-marketing.webp',
  noindex = false,
  schema,
  canonical: canonicalOverride,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = canonicalOverride ?? SITE + path;
const ogImage = image.startsWith('http') ? image : SITE + image;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large'} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PE" />
  <meta property="og:site_name" content="BanaMailing" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/fonts/inter-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <script type="application/ld+json">{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://banamailing.com/#organization",
        "name": "BanaMailing",
        "legalName": "BANA NETWORK SAC",
        "taxID": "20606350644",
        "url": "https://banamailing.com",
        "logo": "https://banamailing.com/images/logo-banamailing.svg",
        "telephone": "+51990137226",
        "email": "banamailing@gmail.com",
        "description": "Agencia de mailing masivo y correos masivos en Perú con más de 500 empresas atendidas, 99% de entregabilidad y 42% de tasa de apertura.",
        "sameAs": ["https://www.facebook.com/banamailing", "https://www.instagram.com/banamailing"]
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://banamailing.com/#localbusiness",
        "name": "BanaMailing — Mailing Masivo en Perú",
        "legalName": "BANA NETWORK SAC",
        "taxID": "20606350644",
        "image": "https://banamailing.com/images/logo-banamailing.svg",
        "url": "https://banamailing.com",
        "telephone": "+51990137226",
        "email": "banamailing@gmail.com",
        "priceRange": "S/ 400 - S/ 2400",
        "currenciesAccepted": "PEN",
        "description": "Servicio profesional de mailing masivo, correos masivos y email marketing en Perú. PowerMTA + AMS Enterprise. Demo gratuita en 48 horas.",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "Av. Armendáriz 480",
            "addressLocality": "Miraflores",
            "addressRegion": "Lima",
            "postalCode": "15074",
            "addressCountry": "PE"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "Chacarilla del Estanque",
            "addressLocality": "Santiago de Surco",
            "addressRegion": "Lima",
            "postalCode": "15038",
            "addressCountry": "PE"
          }
        ],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "09:00",
            "closes": "18:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": "Saturday",
            "opens": "09:00",
            "closes": "13:00"
          }
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://banamailing.com/#website",
        "url": "https://banamailing.com",
        "name": "BanaMailing — Mailing Masivo en Perú",
        "description": "Agencia de mailing masivo y correos masivos en Perú",
        "publisher": { "@id": "https://banamailing.com/#organization" }
      }
    ]
  }</script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
