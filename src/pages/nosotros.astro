---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogosScroll from '../components/LogosScroll.astro';

const SITE = 'https://banamailing.com';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${SITE}/nosotros#webpage`,
      url: `${SITE}/nosotros`,
      name: 'Nosotros — BanaMailing | Agencia de Email Marketing en Perú',
      inLanguage: 'es-PE',
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      breadcrumb: { '@id': `${SITE}/nosotros#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${SITE}/nosotros#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Nosotros', item: `${SITE}/nosotros` },
      ],
    },
  ],
};
---
<BaseLayout
  title="Nosotros — BanaMailing | Agencia de Email Marketing en Perú"
  description="Conoce a BanaMailing: agencia de email marketing y correos masivos en Perú desde 2004. +500 empresas, PowerMTA, AMS Enterprise y medición con Google Analytics."
  schema={schema}
>
  <!-- HERO -->
  <section class="nos-hero">
    <div class="nos-wrap nos-hero-grid">
      <div>
        <nav class="nos-crumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span aria-hidden="true">›</span><span aria-current="page">Nosotros</span></nav>
        <span class="nos-kicker">Desde 2004 · +20 años de experiencia</span>
        <h1>Sobre BanaMailing: tu equipo de <em>email marketing en Perú</em></h1>
        <p class="nos-lead">
          <strong>Banamailing</strong> nació con un propósito claro: ayudar a las empresas a conectar con sus clientes a través de campañas de <strong>email marketing en Perú</strong> altamente efectivas. No somos solo un proveedor de correos masivos: somos el equipo que se encarga de la estrategia, el envío y la medición.
        </p>
        <div class="nos-actions">
          <a class="nos-btn nos-btn-solid" href="/#demo">Solicitar demo gratis</a>
          <a class="nos-btn nos-btn-ghost" href="/contacto">Hablar con nosotros</a>
        </div>
      </div>
      <img
        class="nos-photo"
        src="/images/equipo-colaborativo-mision-email-marketing.webp"
        alt="Equipo de BanaMailing trabajando en campañas de email marketing para empresas peruanas"
        width="1180" height="520" loading="eager" decoding="async"
      />
    </div>
  </section>

  <!-- CIFRAS -->
  <section class="nos-stats" aria-label="BanaMailing en cifras">
    <div class="nos-wrap nos-stats-grid">
      <div><span>+20</span><small>años de experiencia</small></div>
      <div><span>+500</span><small>empresas atendidas</small></div>
      <div><span>99%</span><small>de entregabilidad</small></div>
      <div><span>+200M</span><small>correos enviados</small></div>
    </div>
  </section>

  <!-- HISTORIA -->
  <section class="nos-sec">
    <div class="nos-wrap nos-two">
      <div>
        <h2>Nuestra historia y propósito</h2>
      </div>
      <div class="nos-prose">
        <p>
          Desde 2004 acompañamos a empresas de todos los tamaños a comunicarse con sus clientes por correo electrónico. En ese tiempo hemos visto cambiar las reglas del <strong>correo masivo en Perú</strong>: filtros antispam más estrictos, bandejas más exigentes y clientes que esperan mensajes útiles, no ruido.
        </p>
        <p>
          Por eso trabajamos con una idea simple: un correo solo sirve si <strong>llega a la bandeja de entrada</strong>, lo lee la persona correcta y genera una acción. Todo lo que hacemos, desde segmentar tu base hasta medir los resultados, parte de ahí.
        </p>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS -->
  <section class="nos-sec nos-soft">
    <div class="nos-wrap">
      <h2 class="nos-center">Cómo trabajamos</h2>
      <p class="nos-sub">Tres pilares para que tus campañas de mailing en Perú lleguen, se lean y conviertan.</p>
      <div class="nos-cards">
        <article>
          <span class="nos-num">1</span>
          <h3>Segmentación de bases de correos</h3>
          <p>Ordenamos y segmentamos tu base de datos por industria, cargo, ubicación y otros criterios, para que cada mensaje llegue a quien le interesa.</p>
        </article>
        <article>
          <span class="nos-num">2</span>
          <h3>Envíos con PowerMTA y AMS Enterprise</h3>
          <p>Usamos <strong>PowerMTA y AMS Enterprise</strong>, con IPs y dominios de alta reputación y servidores optimizados, para garantizar envíos de máxima entregabilidad.</p>
        </article>
        <article>
          <span class="nos-num">3</span>
          <h3>Medición con Google Analytics y UTM</h3>
          <p>Medimos aperturas y clics con <strong>Google Analytics y UTM</strong>, y mejoramos cada campaña con remarketing y personalización para maximizar tus conversiones.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CLIENTES -->
  <LogosScroll />

  <!-- DATOS DE LA EMPRESA -->
  <section class="nos-sec">
    <div class="nos-wrap nos-two">
      <div>
        <h2>Datos de la empresa</h2>
        <p class="nos-muted">Somos una empresa peruana constituida. Estos son nuestros datos de contacto y facturación.</p>
      </div>
      <dl class="nos-data">
        <div><dt>Razón social</dt><dd>BANA NETWORK SAC</dd></div>
        <div><dt>RUC</dt><dd>20606350644</dd></div>
        <div><dt>Direcciones</dt><dd>Av. Armendáriz 480, Miraflores 15074, Lima<br>Chacarilla del Estanque, Santiago de Surco, Lima — Perú</dd></div>
        <div><dt>Teléfono / WhatsApp</dt><dd><a href="https://api.whatsapp.com/send?phone=51990137226&text=Hola%2C%20quiero%20conocer%20m%C3%A1s%20sobre%20BanaMailing." target="_blank" rel="noopener noreferrer">+51 990 137 226</a></dd></div>
        <div><dt>Correo</dt><dd><a href="mailto:banamailing@gmail.com">banamailing@gmail.com</a></dd></div>
        <div><dt>Horario de atención</dt><dd>Lunes a viernes 9:00–18:00 · Sábados 9:00–13:00</dd></div>
      </dl>
    </div>
  </section>

  <!-- CTA + enlaces internos -->
  <section class="nos-cta">
    <div class="nos-wrap">
      <h2>¿Hablamos de tu próxima campaña?</h2>
      <p>Te mostramos cómo se vería tu mailing con una demo gratuita.</p>
      <div class="nos-actions nos-center-actions">
        <a class="nos-btn nos-btn-white" href="/#demo">Solicitar demo gratis</a>
        <a class="nos-btn nos-btn-outline" href="/arma-tu-mailing">Arma tu mailing</a>
      </div>
      <p class="nos-more">Conoce también <a href="/expertos-en-email-marketing">nuestra experiencia como expertos en email marketing</a> o <a href="/#precios">los planes y precios</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .nos-wrap { max-width: 1180px; margin: 0 auto; padding: 0 1.5rem; }
  .nos-hero { background: linear-gradient(180deg, #F8F7FC, #fff); padding: 3.5rem 0 4rem; }
  .nos-hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3.5rem; align-items: center; }
  .nos-crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--muted); margin-bottom: 1.2rem; }
  .nos-crumbs a:hover { color: var(--purple); }
  .nos-kicker { display: inline-block; background: var(--purple-light); color: var(--purple); font-weight: 700; font-size: 12px; padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; }
  .nos-hero h1 { font-size: clamp(2rem, 4.4vw, 3.4rem); font-weight: 900; line-height: 1.07; letter-spacing: -0.04em; margin-bottom: 1.1rem; }
  .nos-hero h1 em { color: var(--purple); font-style: normal; }
  .nos-lead { color: var(--muted); font-size: 1.08rem; line-height: 1.75; margin-bottom: 1.6rem; }
  .nos-lead strong { color: var(--text); }
  .nos-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .nos-btn { display: inline-block; padding: 13px 24px; border-radius: 11px; font-weight: 700; font-size: 15px; transition: transform .1s, background .15s, box-shadow .15s; }
  .nos-btn:hover { transform: translateY(-2px); }
  .nos-btn-solid { background: var(--purple); color: #fff; box-shadow: 0 8px 24px rgba(103,76,196,.3); }
  .nos-btn-solid:hover { background: var(--purple-dark); }
  .nos-btn-ghost { border: 1.5px solid var(--border); background: #fff; color: var(--text); }
  .nos-btn-ghost:hover { border-color: var(--purple); color: var(--purple); }
  .nos-btn-white { background: #fff; color: var(--purple); }
  .nos-btn-outline { border: 1.5px solid rgba(255,255,255,.7); color: #fff; }
  .nos-photo { width: 100%; height: auto; border-radius: 20px; box-shadow: 0 20px 50px rgba(28,28,28,.12); }

  .nos-stats { background: var(--purple); color: #fff; padding: 2.2rem 0; }
  .nos-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center; }
  .nos-stats span { display: block; font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; letter-spacing: -0.03em; line-height: 1; }
  .nos-stats small { display: block; font-size: 13.5px; opacity: .85; margin-top: 6px; }

  .nos-sec { padding: 4.5rem 0; }
  .nos-soft { background: #F8F7FC; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .nos-two { display: grid; grid-template-columns: 1fr 1.5fr; gap: 3.5rem; align-items: start; }
  .nos-sec h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 900; letter-spacing: -0.035em; line-height: 1.1; }
  .nos-center { text-align: center; }
  .nos-sub { text-align: center; color: var(--muted); margin: .7rem auto 2.4rem; max-width: 560px; line-height: 1.6; }
  .nos-prose p { color: var(--muted); font-size: 1.04rem; line-height: 1.8; margin-bottom: 1.1rem; }
  .nos-prose strong { color: var(--text); }
  .nos-muted { color: var(--muted); margin-top: .8rem; line-height: 1.6; }

  .nos-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .nos-cards article { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 1.7rem 1.5rem; }
  .nos-num { display: inline-flex; width: 36px; height: 36px; border-radius: 10px; background: var(--purple-light); color: var(--purple); font-weight: 800; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .nos-cards h3 { font-size: 1.12rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: .6rem; line-height: 1.25; }
  .nos-cards p { color: var(--muted); font-size: .97rem; line-height: 1.7; }
  .nos-cards strong { color: var(--text); }

  .nos-data { display: grid; gap: 0; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
  .nos-data > div { display: grid; grid-template-columns: 170px 1fr; gap: 1rem; padding: 14px 18px; border-bottom: 1px solid var(--border); }
  .nos-data > div:last-child { border-bottom: 0; }
  .nos-data > div:nth-child(odd) { background: #FAFAFC; }
  .nos-data dt { font-weight: 700; font-size: 14px; color: var(--text); }
  .nos-data dd { color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .nos-data a { color: var(--purple); font-weight: 600; }

  .nos-cta { background: linear-gradient(135deg, #5038A8, #674CC4); color: #fff; text-align: center; padding: 4.2rem 0; }
  .nos-cta h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 900; letter-spacing: -0.035em; }
  .nos-cta p { opacity: .9; margin: .8rem 0 1.6rem; }
  .nos-center-actions { justify-content: center; }
  .nos-more { font-size: 14px; margin-top: 1.8rem !important; margin-bottom: 0 !important; }
  .nos-more a { text-decoration: underline; font-weight: 600; }

  @media (max-width: 900px) {
    .nos-hero-grid, .nos-two, .nos-cards { grid-template-columns: 1fr; }
    .nos-hero { padding: 2.2rem 0 3rem; }
    .nos-hero-grid, .nos-two { gap: 1.6rem; }
    .nos-stats-grid { grid-template-columns: 1fr 1fr; row-gap: 1.6rem; }
    .nos-sec { padding: 3rem 0; }
    .nos-data > div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
