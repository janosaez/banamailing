# Envío de correos de prueba (https://resend.com)
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej.:
MAIL_FROM="BanaMailing Pruebas <prueba@banamailing.com>"

# Límites (https://upstash.com — Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tope diario global de pruebas (opcional, por defecto 80)
MAIL_DAILY_CAP=80

# Captcha Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
